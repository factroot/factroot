# FactRoot backend secrets. Copy this file to .env.local and fill in your values.
X_BEARER_TOKEN=your_x_api_bearer_token
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key

# Gmail SMTP password reset settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_sender_address@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
SMTP_FROM_NAME=FactRoot
